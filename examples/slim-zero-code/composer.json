{
  "name": "example/opentelemetry-slim-zero-code",
  "description": "OpenTelemetry PHP zero-code instrumentation example for Slim",
  "type": "project",
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "guzzlehttp/guzzle": "^7.9",
    "nyholm/psr7": "^1.8",
    "open-telemetry/exporter-otlp": "^1.3",
    "open-telemetry/opentelemetry-auto-psr18": "^1.1",
    "open-telemetry/opentelemetry-auto-slim": "^1.0",
    "open-telemetry/sdk": "^1.7",
    "php-http/guzzle7-adapter": "^1.1",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.15"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    },
    "sort-packages": true
  }
}

